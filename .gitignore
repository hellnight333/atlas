# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage artifacts
.coverage
coverage.xml

# Node
node_modules/
.next/
dist/
.turbo/

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Models & weights — these live on the NAS, not in git
*.safetensors
*.ckpt
*.pt
*.bin
*.gguf
models/

# Generated media — the Asset Library owns these
outputs/
assets/
*.mp4
*.mov
*.wav
*.png
*.jpg
!docs/**/*.png

# Application and site artwork are source, not generated media. Without these
# exceptions the icon set never reaches git and a CI build has nothing to
# bundle. Regenerate with infra/packaging/make_icons.py.
!apps/desktop/src-tauri/icons/
!apps/desktop/src-tauri/icons/**
!website/assets/
!website/assets/**

# Source code, not generated media. The blanket `assets/` rule above silently
# excluded apps/desktop/src/features/assets/, so router.tsx imported a screen
# that was never committed and a clean checkout could not compile.
!apps/desktop/src/assets/
!apps/desktop/src/assets/**
!apps/desktop/src/features/assets/
!apps/desktop/src/features/assets/**

# OS
.DS_Store

# Packaging artefacts. The bundled PostgreSQL is ~130 MB and is fetched by
# infra/packaging/fetch_postgres.py; the kernel binary is built by PyInstaller.
# Neither belongs in git.
apps/desktop/src-tauri/resources/postgres/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
infra/packaging/build/
infra/packaging/dist/
dist-release/
