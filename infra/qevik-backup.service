[Unit]
Description=Qevik database backup (taken and verified by restore)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=qevik
Group=qevik
WorkingDirectory=/opt/qevik/atlas
ExecStart=/opt/qevik/atlas/infra/qevik_backup.sh
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/qevik
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qevik-backup
