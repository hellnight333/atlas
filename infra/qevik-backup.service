[Unit]
Description=Qevik database backup (taken and verified by restore)
After=postgresql.service
Requires=postgresql.service
# On failure a marker is written so a silent five-day gap cannot recur (F-6).
# The off-host copy (qevik-offsite.timer, 04:15 UTC) runs on its own clock so a
# failed dump still ships yesterday's verified dump and all non-database state.
OnFailure=qevik-backup-failed@%p.service

[Service]
Type=oneshot
User=qevik
Group=qevik
WorkingDirectory=/opt/qevik/atlas
# Read as root, before the drop to User=qevik. The script cannot source this
# file itself: it is root-owned 0600 and the service user cannot read it.
EnvironmentFile=/opt/qevik/atlas.env
ExecStart=/opt/qevik/atlas/infra/qevik_backup.sh
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/qevik
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qevik-backup
