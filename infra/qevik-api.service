[Unit]
# The Qevik control-plane API.
#
# Installed by infra/install_qevik_service.sh. Managed rather than nohup-ed
# because "run my system" means it survives a reboot and comes back after a
# crash, and a backgrounded process does neither.
Description=Qevik Core API
Documentation=https://github.com/hellnight333/atlas
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=exec
User=qevik
Group=qevik
WorkingDirectory=/opt/qevik/atlas

# The database URL lives here, 0600, owned by qevik. It is not in Git and not
# in this unit file — a unit file is world-readable, and a password in one is a
# password in `systemctl cat`.
EnvironmentFile=/opt/qevik/atlas.env

# Where the kernel is imported from. Every other unit has said this all along;
# this one did not, and got away with it because the old host's venv had the
# project installed editable — `bootstrap_qevik_server.sh` git-cloned the whole
# repository there. The ADR-0010 payload ships the package and not
# `pyproject.toml`, so on a host provisioned the supported way there is nothing
# to install and `python -m uvicorn atlas_kernel.api:app` cannot find its own
# package. The first deploy to qevik-prod-01 failed exactly there.
Environment=PYTHONPATH=/opt/qevik/atlas/packages/kernel

# Bound to loopback deliberately. This API has no authentication layer, so it
# must not be reachable from the internet. Access is over an SSH tunnel until
# there is a real auth story. Changing this line to 0.0.0.0 publishes an
# unauthenticated control plane.
#
# No --log-config. Passing /dev/null makes uvicorn try to *parse* it as a
# logging config and die with "is an empty file"; the launcher's log_config=None
# is a Python value with no command-line equivalent. Default logging goes to
# stdout, which systemd captures into the journal, which is what was wanted.
ExecStart=/opt/qevik/atlas/.venv/bin/python -m uvicorn atlas_kernel.api:app \
    --host 127.0.0.1 --port 8080

Restart=on-failure
RestartSec=5s
# Give up rather than restart-loop forever; a service failing 5 times in a
# minute is broken in a way restarting will not fix, and the log should say so.
# StartLimitBurst and StartLimitIntervalSec used to sit here, in [Service],
# where systemd ignores them and says so on every reload — a restart rate limit
# that silently did nothing while reading as protection. They now live in
# [Unit], in the resources.conf drop-in, which is also where they survive this
# unit being redeployed.

# Hardening. None of this is exotic; it is the set that costs nothing and
# removes whole categories of blast radius on a box that will later run
# generated code.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/qevik
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=qevik-api

[Install]
WantedBy=multi-user.target
