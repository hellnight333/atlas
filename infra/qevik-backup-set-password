#!/usr/bin/env bash
#
# Set (or rotate) the restic repository password for the off-host backup.
#
# The password is typed here, on the target, by the owner — it never passes
# through chat, git, a log line, or an agent. It lands in /opt/qevik/backup.env
# (root 0600), which qevik-offsite.service reads via EnvironmentFile=, the same
# way every other Qevik unit gets its secrets.
#
# Keep a copy in your password manager. Without it the Storage Box holds
# nothing but ciphertext: this is what makes the backup restorable after a
# total server loss — and unreadable without you.
#
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 1; }
ENV=/opt/qevik/backup.env
if [ -f "$ENV" ] && grep -q '^RESTIC_PASSWORD=.' "$ENV"; then
  echo "A password is already set in $ENV."
  echo "Rotating it re-keys the repository (restic key add / remove) — only do that deliberately."
  read -r -p "Replace it anyway? [y/N] " yn; [ "${yn:-n}" = y ] || exit 0
fi
read -r -s -p "restic repository password: " p1; echo
read -r -s -p "again: " p2; echo
[ "$p1" = "$p2" ] || { echo "mismatch, nothing written" >&2; exit 1; }
[ ${#p1} -ge 16 ] || { echo "use at least 16 characters, nothing written" >&2; exit 1; }
umask 077
printf 'RESTIC_PASSWORD=%s\n' "$p1" > "${ENV}.tmp"
chown root:root "${ENV}.tmp"; chmod 600 "${ENV}.tmp"; mv "${ENV}.tmp" "$ENV"
unset p1 p2
echo "written: $ENV ($(stat -c '%U:%G %a' "$ENV")), keys: $(cut -d= -f1 "$ENV" | tr '\n' ' ')"
