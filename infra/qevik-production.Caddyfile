# Qevik in production, behind Cloudflare.
#
# Cloudflare proxies all four hostnames, and its SSL/TLS mode is Full or Full
# (strict) — established by observation rather than assumption: HTTPS through
# Cloudflare returned 522 (timeout to origin) while plain HTTP returned a 404
# from this origin's :80. A Flexible zone would have served both from :80, so
# Cloudflare is dialling origin **port 443** and the origin must answer there
# with a real certificate.
#
# Certificates come from Let's Encrypt over HTTP-01. TLS-ALPN-01 cannot work
# through a proxied record — Cloudflare terminates TLS, so the challenge never
# reaches this server — and Caddy tries it first by default. It is disabled
# explicitly below rather than left to fail and retry.

{
	# The admin API is a control surface that can rewrite this server's entire
	# configuration over HTTP. It listens on localhost only, but this host runs
	# a control plane, and "localhost only" is one container escape or one
	# careless bind from being wrong. The cost of turning it off is that config
	# changes need `systemctl restart` rather than `reload` — a few seconds of
	# downtime on a deploy, which is cheaper than the alternative.
	admin off
	email qevikos@gmail.com

	servers {
		# Behind a proxy every request arrives from a Cloudflare address. Without
		# this, the login rate limiter and the audit trail record Cloudflare as
		# the client: one attacker would consume the limit for everybody, and
		# "who signed in" would answer with a datacentre. Declaring the ranges
		# lets Caddy trust CF-Connecting-IP and recover the real client.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 \
			103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 \
			188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 \
			104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

(security) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}

(le) {
	tls {
		issuer acme {
			# See the header: TLS-ALPN cannot complete through a proxied record.
			disable_tlsalpn_challenge
		}
	}
}

# --- public marketing site --------------------------------------------------
#
# This site is NOT a single-page application and must never be served as one.
# `apps/public/build.py` writes one directory per page — services/index.html,
# work/apex/index.html, ar/contact/index.html — plus a sitemap listing every
# one of them.
#
# It was served as one. `try_files {path} /index.html` is the SPA fallback, and
# `try_files` tests for a *file*: a request for `/services/` is a directory, so
# it missed every candidate and was rewritten to the homepage. Measured on the
# live site 2026-09-01 — `/services/` returned 25,331 bytes titled "Qevik —
# digital products built around your business" while
# `/srv/qevik-public/services/index.html` was a real 7,362-byte page titled
# "Services — Qevik". The same for /about/, /contact/, /work/, all seven case
# studies and the entire Arabic site, and `/nonsense-does-not-exist/` answered
# HTTP 200 with the homepage. Every navigation link on the site was broken,
# ~60 KB of written content was unreachable, and the sitemap advertised a dozen
# URLs that served identical bytes.
#
# The fix is to stop rewriting rather than to write a cleverer rewrite:
# `file_server` resolves a directory to its own `index.html` unaided, and
# returns a real 404 for what is not there. The `sites.qevik.ai` block below has
# always relied on exactly that — it is how `/slug/ar/` resolves there.
qevik.ai {
	import le
	import security
	root * /srv/qevik-public
	file_server

	# A URL that is not a page here is a 404, not a 200 carrying the homepage.
	# The page served is built by the same builder as every other page, so it
	# arrives with the site's header, navigation, phone number and
	# operating-entity footer instead of as a bare server error.
	handle_errors {
		# The Arabic site is a whole second site under /ar/. Someone who
		# mistypes a URL there must not be answered in English, left-to-right.
		#
		# The expressions are backtick-quoted so each is a single Caddyfile
		# argument. Unquoted they are three, which older `expression` matchers
		# reject outright — and a config that fails to parse takes the whole
		# server down, not just this block.
		@ar_404 {
			expression `{err.status_code} == 404`
			path /ar/*
		}
		@404 expression `{err.status_code} == 404`

		handle @ar_404 {
			rewrite * /ar/404.html
			# `status` is not optional here. Without it `file_server` answers
			# 200 and the error page is indexed as a real page — the same lie
			# the SPA fallback was telling. Needs Caddy >= 2.7; the deploy runs
			# `caddy validate` before restarting, so an older binary refuses
			# loudly rather than serving a soft 404.
			file_server {
				status 404
			}
		}
		handle @404 {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		handle {
			# Anything other than a missing page is unexpected on a directory
			# of static files. Answer plainly rather than dressing an unknown
			# failure up as a page somebody designed.
			respond "{err.status_code} {err.status_text}" {err.status_code}
		}
	}

	log {
		format console
	}
}

# --- www redirects to the bare domain ---------------------------------------
www.qevik.ai {
	import le
	redir https://qevik.ai{uri} permanent
}

# --- operator control application -------------------------------------------
app.qevik.ai {
	import le
	import security

	# The API stays bound to 127.0.0.1:8080 and is never published directly.
	# Caddy is the only thing that talks to it, so there is exactly one door and
	# it is authenticated on the other side.
	# Two services behind one domain, and the split is not arbitrary.
	#
	# :8080 is `atlas_kernel.api:app` — 181 Atlas routes plus the sales console's
	# API — and it carries a middleware that rewrites `/api/X` to `/X` for the
	# desktop client. Mounting the Qevik control plane there turned
	# `/api/missions` into `/missions` and answered HTML with a 200 where an
	# authenticated JSON API belongs.
	#
	# :8081 is `atlas_kernel.qevik.app:from_environment` — the composed control
	# plane the acceptance suite actually exercises, where `/api/` is a real
	# namespace rather than an alias.
	#
	# `/control/*` deliberately stays on :8080 so the sales console keeps working.
	handle /api/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle /auth/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle /control/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /health {
		reverse_proxy 127.0.0.1:8081
	}
	handle {
		root * /srv/qevik-control
		try_files {path} /index.html
		file_server
	}

	header {
		# The console loads nothing third-party, so the strictest policy that
		# works is the right one.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:"
	}
	log {
		format console
	}
}

# --- customer and demo sites ------------------------------------------------
sites.qevik.ai {
	import le
	import security
	root * /srv/sites

	# A site directory holds `versions/` and a `current` symlink; the live
	# document root is the symlink. This is the server-side half of
	# publish-then-promote — the adapter moves files and swaps the link, and the
	# web server decides which version is served.
	@site_root path_regexp siteroot ^/([^/]+)/?$
	rewrite @site_root /{re.siteroot.1}/current/

	# Anything deeper than the site root goes through `current/` too. Without
	# this only the homepage resolved: /slug/ar/, /slug/robots.txt and
	# /slug/sitemap.xml were looked up beside the `current` symlink rather than
	# through it, so a bilingual site served its English page and 404'd on
	# everything else.
	#
	# Expressed as a matcher set because Go's RE2 has no negative lookahead, and
	# a path already containing /current/ must not be rewritten twice.
	@site_deep {
		path_regexp deep ^/([^/]+)/(.+)$
		not path /*/current/*
	}
	rewrite @site_deep /{re.deep.1}/current/{re.deep.2}

	file_server
	header X-Qevik-Host "sites"
	log {
		format console
	}
}

# --- the operator's way back in ---------------------------------------------
#
# There is no `:8443` door here any more (D-D, 2026-09-03). It was a self-signed
# site on the bare IP, and it had never worked: the host firewall dropped 8443,
# so the "second route to the control plane" was a hard-coded address that
# answered nothing. Keeping it would also mean carrying one production host's IP
# in the configuration of another.
#
# The break-glass is the Hetzner console plus SSH, which is what was actually
# used every time. `infra/secure_8443.sh` — the never-applied proposal to lock
# this block down — goes with it.

# --- the bare IP stays available as development infrastructure --------------
#
# Not customer-facing. It keeps working so a broken DNS or Cloudflare change
# never locks the operator out of their own control plane.
:80 {
	root * /srv/sites
	@site_root path_regexp siteroot ^/([^/]+)/?$
	rewrite @site_root /{re.siteroot.1}/current/

	# Anything deeper than the site root goes through `current/` too. Without
	# this only the homepage resolved: /slug/ar/, /slug/robots.txt and
	# /slug/sitemap.xml were looked up beside the `current` symlink rather than
	# through it, so a bilingual site served its English page and 404'd on
	# everything else.
	#
	# Expressed as a matcher set because Go's RE2 has no negative lookahead, and
	# a path already containing /current/ must not be rewritten twice.
	@site_deep {
		path_regexp deep ^/([^/]+)/(.+)$
		not path /*/current/*
	}
	rewrite @site_deep /{re.deep.1}/current/{re.deep.2}
	file_server
	header X-Qevik-Host "sites-origin"
}
