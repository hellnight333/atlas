# Qevik Control — the operator console.
#
# Deliberately a separate listener from the public site host on :80. Customer
# sites and the control plane must not share an origin: a deployed page is
# attacker-influenced content, and same-origin means it could read the session
# cookie of whoever is logged in. Different port, different origin, no overlap.
#
# **TLS is Caddy's internal CA, not a public certificate.** No domain resolves
# to this host, and no authority issues for a bare IP, so this is a self-signed
# certificate and the browser will warn on first visit. That warning is honest
# and should not be papered over — what it buys is an encrypted channel for the
# session cookie, which plain HTTP would send in the clear on every request.
# Point a domain here and Caddy will replace it with a real certificate.
https://2.28.62.83:8443 {
	# Internal CA scoped to THIS site only. Setting `local_certs` globally would
	# make every site use the internal issuer, so the day a real domain is added
	# it would silently get a self-signed certificate instead of a public one.
	tls internal

	# The API stays bound to loopback. Caddy is the only thing that talks to it,
	# which keeps the "never expose the control plane directly" property true
	# even now that authentication exists: there is exactly one door.
	handle /auth/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /control/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /health {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		root * /srv/qevik-control
		try_files {path} /index.html
		file_server
	}

	header {
		# The console loads no third-party anything, so the strictest policy
		# that still works is the correct one.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		format console
	}
}
