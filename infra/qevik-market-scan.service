[Unit]
# The daily market scan. Answers "which niche, which geography" from live data
# so the answer stays current without anyone being asked for it.
#
# Research only: it reads public pages and a maps API. It contacts nobody,
# writes to nobody, and produces no proposals. Outreach stays behind the
# approval gate where it belongs.
Description=Qevik daily market scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=qevik
Group=qevik
WorkingDirectory=/opt/qevik/atlas
EnvironmentFile=/opt/qevik/atlas.env
# Absent by default, so the scan runs free against OpenStreetMap until a Places
# key exists. -EnvironmentFile means "use it if present" rather than fail.
EnvironmentFile=-/opt/qevik/places.env
# Same reason as every other unit: the payload ships the package, not the
# project, so the kernel is imported from here. Without it this fails when the
# timer fires rather than when the deploy runs — a 06:00 failure nobody is
# watching, instead of one in front of the person deploying.
Environment=PYTHONPATH=/opt/qevik/atlas/packages/kernel
# --source places because the scan itself measured why: reachability was
# 2–17% on OpenStreetMap and 83–100% on Places, and an unreachable prospect is
# not a prospect. A whole run is roughly $0.58.
ExecStart=/opt/qevik/atlas/.venv/bin/python infra/market_scan.py \
    --area dubai --source places --sample 10 --json /opt/qevik/market/latest.json
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/qevik
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qevik-market-scan
